nhn_identity_endpoint="YOUR_NHN_CLOUD_IDENTITY_ENDPOINT"
nhn_username="YOUR_NHN_CLOUD_USERNAME"
nhn_password="YOUR_NHN_CLOUD_PASSWORD"
nhn_domain_name="YOUR_NHN_CLOUD_DOMAIN_NAME"
nhn_tenant_id="YOUR_NHN_CLOUD_TENANT_ID"

# for S3, cf) https://github.com/cloud-barista/cb-spider/wiki/Object-Storage-and-S3-API-Guide
nhn_access_key="YOUR_NHN_ACCESS_KEY"
nhn_secret_key="YOUR_NHN_SECRET_KEY"
# for RDBMS, cf) https://github.com/cloud-barista/cb-spider/wiki/RDBMS%E2%80%90Management%E2%80%90Guide
nhn_rds_user_access_key="YOUR_NHN_RDS_USER_ACCESS_KEY"
nhn_rds_secret_access_key="YOUR_NHN_RDS_SECRET_ACCESS_KEY"
nhn_rds_mysql_app_key="YOUR_NHN_RDS_MYSQL_APP_KEY"
nhn_rds_mariadb_app_key="YOUR_NHN_RDS_MARIADB_APP_KEY"
