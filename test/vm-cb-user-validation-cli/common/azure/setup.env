# Azure AKS requires 333+ IPs in the subnet => /23
SUBNET_CIDR=10.25.6.0/23
CONN_CONFIG=azure-northeu-config
IMAGE_NAME=Canonical:ubuntu-25_04-daily:minimal:25.04.202601140
SPEC_NAME=Standard_B1ls

# --- Disk / NLB / S3 / Cluster (cf. spiderwatch/conf/spiderwatch.yaml) ---
DISK_TYPE=PremiumSSD
DISK_SIZE=10
NLB_LISTENER_PORT=22
NLB_TARGET_PORT=22
CLUSTER_VERSION=1.35.0
NODEGROUP_TYPE=type2
NODEGROUP_SPEC_NAME=Standard_B2s
NODEGROUP_ROOT_DISK_SIZE=30
