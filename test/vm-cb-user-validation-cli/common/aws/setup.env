CONN_CONFIG=aws-config01
IMAGE_NAME=ami-0131a0fdbb6fda7e6
SPEC_NAME=t2.micro

# --- Disk / NLB / S3 / Cluster (cf. spiderwatch/conf/spiderwatch.yaml) ---
DISK_TYPE=gp2
DISK_SIZE=10
NLB_LISTENER_PORT=80
NLB_TARGET_PORT=80
CLUSTER_VERSION=1.32
NODEGROUP_TYPE=type1
NODEGROUP_SPEC_NAME=t3.medium
NODEGROUP_ROOT_DISK_TYPE=gp2
NODEGROUP_ROOT_DISK_SIZE=20
# AWS EKS requires subnets in at least 2 AZs (aws-config01: ap-southeast-2a)
EXTRA_SUBNET_CIDR=10.25.8.0/24
EXTRA_SUBNET_ZONE=ap-southeast-2b
