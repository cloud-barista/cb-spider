PREFIX=SPIDER-VM-SSH-Test


VPC_NAME=${PREFIX}-vpc-01
#VPC_CIDR=192.168.0.0/16
VPC_CIDR=10.25.0.0/16
SUBNET_NAME=${PREFIX}-subnet-01
#SUBNET_CIDR=192.168.1.0/24
SUBNET_CIDR=10.25.7.0/24
SG_NAME=${PREFIX}-SG01
KEYPAIR_NAME=${PREFIX}-keypair-01

VM_NAME=${PREFIX}-VM

DISK_NAME=${PREFIX}-disk-01
MYIMAGE_NAME=${PREFIX}-myimage-01
NLB_NAME=${PREFIX}-nlb-01

# Cluster/NodeGroup: short lowercase names (CSP naming rules, e.g. AKS node pool)
CLUSTER_NAME=spider-ctest
NODEGROUP_NAME=spider-ctest
# extra subnet for Cluster (only when EXTRA_SUBNET_CIDR is set in CSP setup.env, e.g. AWS EKS needs 2 AZs)
EXTRA_SUBNET_NAME=${PREFIX}-subnet-02

# Object Storage(S3) bucket: globally unique name => "<S3_PREFIX><timestamp>"
#   - delete script removes all buckets that start with S3_PREFIX
S3_PREFIX=spider-ctest-

# paths are derived from this file's location (independent of CBSPIDER_ROOT,
# which may point to another cb-spider checkout)
COMMON_PATH=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd "$COMMON_PATH/../../.." && pwd)
if [ -x "$REPO_ROOT/cli/spctl" ]; then
	CLIPATH=$REPO_ROOT/cli
else
	CLIPATH=$CBSPIDER_ROOT/cli
fi
SPIDER_USERNAME=${SPIDER_USERNAME:-admin}
SPIDER_PASSWORD=$SPIDER_PASSWORD
RESTSERVER=${RESTSERVER:-localhost}
SPIDER_URL=http://${RESTSERVER}:1024/spider

#----------------------------------------------------------------------
# Default per-resource settings (overridden in CSP setup.env)
#   cf) spiderwatch/conf/spiderwatch.yaml
#----------------------------------------------------------------------
DISK_TYPE=default
DISK_SIZE=default

NLB_TYPE=PUBLIC
NLB_SCOPE=REGION
NLB_LISTENER_PROTOCOL=TCP
NLB_LISTENER_PORT=80
NLB_TARGET_PROTOCOL=TCP
NLB_TARGET_PORT=80
NLB_HEALTH_PROTOCOL=TCP
NLB_HEALTH_PORT=22
# true: include VM in NLB create request (KT Cloud requires a VM at creation time)
NLB_VM_REQUIRED_AT_CREATE=false

S3_SUPPORT=true

CLUSTER_SUPPORT=true
CLUSTER_VERSION=
# type1: add NodeGroup after Cluster is Active (AWS, Alibaba, Tencent)
# type2: NodeGroup is created with Cluster   (Azure, GCP, IBM, NCP, NHN)
NODEGROUP_TYPE=type2
NODEGROUP_IMAGE_NAME=
NODEGROUP_SPEC_NAME=
NODEGROUP_ROOT_DISK_TYPE=default
NODEGROUP_ROOT_DISK_SIZE=default
NODEGROUP_ON_AUTO_SCALING=true
NODEGROUP_DESIRED_NODE_SIZE=1
NODEGROUP_MIN_NODE_SIZE=1
NODEGROUP_MAX_NODE_SIZE=3
EXTRA_SUBNET_CIDR=
EXTRA_SUBNET_ZONE=

# CSP setup.env path
CSPSETUP_PATH=$COMMON_PATH/$1

source $CSPSETUP_PATH/setup.env
