CONN_CONFIG=openstack-config01
IMAGE_NAME=78d90dae-d21d-4606-a9dd-c1268e321864
SPEC_NAME=m1.small

# --- Disk / NLB / S3 / Cluster (cf. spiderwatch/conf/spiderwatch.yaml) ---
DISK_TYPE=default
DISK_SIZE=10
NLB_LISTENER_PORT=80
NLB_TARGET_PORT=80
# Cluster is not supported for OpenStack (S3: Swift S3 API on <IdentityEndpoint host>:8080, keys: openstack_access/openstack_secret)
CLUSTER_SUPPORT=false
