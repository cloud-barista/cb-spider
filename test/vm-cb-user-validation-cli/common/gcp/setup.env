CONN_CONFIG=gcp-iowa-config
IMAGE_NAME=https://www.googleapis.com/compute/v1/projects/ubuntu-os-cloud/global/images/ubuntu-2404-noble-amd64-v20240423
SPEC_NAME=e2-standard-2

# --- Disk / NLB / S3 / Cluster (cf. spiderwatch/conf/spiderwatch.yaml) ---
DISK_TYPE=pd-standard
DISK_SIZE=10
NLB_LISTENER_PORT=80
NLB_TARGET_PORT=80
# GCP Target Pool-based NLB only supports HTTP health checks
NLB_HEALTH_PROTOCOL=HTTP
NLB_HEALTH_PORT=80
CLUSTER_VERSION=
NODEGROUP_TYPE=type2
NODEGROUP_SPEC_NAME=e2-standard-4
NODEGROUP_ROOT_DISK_SIZE=30
